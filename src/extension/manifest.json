{
  "manifest_version": 3,
  "name": "FocusBuddy Blocker",
  "version": "1.0.0",
  "description": "Blocks distracting sites in Chrome while a FocusBuddy Pomodoro session is running.",
  "permissions": ["declarativeNetRequest", "alarms", "tabs", "webNavigation"],
  "host_permissions": [
    "http://127.0.0.1:47990/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
